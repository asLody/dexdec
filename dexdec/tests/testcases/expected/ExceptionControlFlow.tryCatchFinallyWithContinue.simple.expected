    # -> BBB8, BBB22, BBB23
    # throws -> BB28, BB26

BBB8:
    # preds: BBB7
    v1 = v1 + v3  # 0012:
    if v1 <= 50 goto BB31  # 0015:
    # -> BBB24, BBB9

BBB9:
    # preds: BBB8
    nop  # 0017:
    nop  # 0018:
    return v1  # 0019:

BBB10:
    # preds: BBB16, BBB19, BBB21, BBB23
    move-exception v4  # 001a:
    throw v4  # 001b:

BBB11:
    # preds: BBB15, BBB18, BBB20, BBB22
    move-exception v2  # 001c:
    v1 = v1 + -1  # 001d:
    # -> BBB12

BBB12:
    # preds: BBB11, BBB24
    v1 = v1 + 2  # 001f:
    nop  # 0021:
    # -> BBB13

BBB13:
    # preds: BBB12, BBB17
    v0 = v0 + 1  # 0022:
    goto BB3  # 0024:
    # -> BBB1

BBB14:
    # preds: BBB1
    return v1  # 0025:

BBB15:
    # preds: BBB2
    goto BB0
    # -> BBB11
    # throws -> BB28, BB26

