.method tryCatchFinallyWithContinue
.registers 5
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/ArithmeticException; {BB6..BB18} -> BB28
# .catch Ljava/lang/Throwable; {BB6..BB18} -> BB26

BBB0:  # entry
    nop
    const v0 = 0  # 0001:
    const v1 = 0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB13
    v2 = v4.length  # 0003:
    if v0 >= v2 goto BB37  # 0004:
    # -> BBB14, BBB2

BBB2:
    # preds: BBB1
    v2 = v4[v0]  # 0006:
    # -> BBB3, BBB15, BBB16
    # throws -> BB28, BB26

BBB3:
    # preds: BBB2
    if v2 != 0 goto BB13  # 0008:
    # -> BBB6, BBB4
    # throws -> BB28, BB26

BBB4:
    # preds: BBB3
    v1 = v1 + 2  # 000a:
    # -> BBB17, BBB18, BBB19
    # throws -> BB28, BB26

BBB6:
    # preds: BBB3
    v2 = v4[v0]  # 000d:
    # -> BBB7, BBB20, BBB21
    # throws -> BB28, BB26

BBB7:
    # preds: BBB6
