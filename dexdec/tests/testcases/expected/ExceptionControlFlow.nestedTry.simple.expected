.method nestedTry
.registers 1
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/IllegalArgumentException; {BB4..BB10} -> BB13
# .catch Ljava/lang/RuntimeException; {BB4..BB10} -> BB10

BBB0:  # entry
    if v0 < 0 goto BB4
    # -> BBB2, BBB1

BBB1:
    # preds: BBB0
    return 1  # 0003:

BBB2:
    # preds: BBB0
    nop
    # -> BBB3, BBB7, BBB8
    # throws -> BB13, BB10

BBB3:
    # preds: BBB2
    v0 = new Ljava/lang/IllegalArgumentException;()  # 0006:
    # -> BBB4, BBB9, BBB10
    # throws -> BB13, BB10

BBB4:
    # preds: BBB3
    throw v0  # 0009:
    # -> BBB11, BBB12
    # throws -> BB13, BB10

BBB5:
    # preds: BBB8, BBB10, BBB12
    move-exception v0  # 000a:
    return 3  # 000c:

BBB6:
    # preds: BBB7, BBB9, BBB11
    move-exception v0  # 000d:
    return 2  # 000f:

BBB7:
    # preds: BBB2
    goto BB0
    # -> BBB6
    # throws -> BB13, BB10

BBB8:
    # preds: BBB2
    goto BB0
    # -> BBB5
    # throws -> BB13, BB10

BBB9:
    # preds: BBB3
    goto BB0
    # -> BBB6
    # throws -> BB13, BB10

BBB10:
    # preds: BBB3
    goto BB0
    # -> BBB5

BBB11:
    # preds: BBB4
    goto BB0
    # -> BBB6

BBB12:
    # preds: BBB4
    goto BB0
    # -> BBB5

