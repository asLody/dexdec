.method syncWithFinally
.registers 3
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/ArithmeticException; {BB6..BB7} -> BB17
# .catch Ljava/lang/Throwable; {BB6..BB7} -> BB12
# .catch Ljava/lang/Throwable; {BB7..BB26} -> BB10

BBB0:  # entry
    nop
    v0 = LSynchronizedAdvanced;->lock1:Ljava/lang/Object;  # 0001:
    monitor-enter v0  # 0003:
    # -> BBB1

BBB1:
    # preds: BBB0
    v1 = 100 / v2  # 0006:
    # -> BBB2, BBB7, BBB5
    # throws -> BB17, BB12

BBB2:
    # preds: BBB1
    LSynchronizedAdvanced;->value:I = v1  # 0007:
    # -> BBB13, BBB14
    # throws -> BB10

BBB4:
    # preds: BBB6, BBB14, BBB15, BBB16, BBB18, BBB19
    move-exception v2  # 000a:
    monitor-exit v0  # 0019:
    # -> BBB12, BBB15
    # throws -> BB10

BBB5:
    # preds: BBB1
    move-exception v2  # 000c:
    LSynchronizedAdvanced;->value:I = 0  # 000e:
    # -> BBB6, BBB16
    # throws -> BB10

BBB6:
    # preds: BBB5
    throw v2  # 0010:
    # -> BBB4
    # throws -> BB10

BBB7:
    # preds: BBB1
    move-exception v2  # 0011:
    nop  # 0012:
    const v1 = -1  # 0013:
    LSynchronizedAdvanced;->value:I = v1  # 0014:
    # -> BBB17, BBB18
    # throws -> BB10

BBB9:
    # preds: BBB13, BBB17
    monitor-exit v0  # 0017:
    # -> BBB10, BBB19
    # throws -> BB10

BBB10:
    # preds: BBB9
    return v1  # 0018:
    # throws -> BB10

BBB12:
    # preds: BBB4
    throw v2  # 001b:

BBB13:
    # preds: BBB2
    goto BB0
    # -> BBB9
    # throws -> BB10

BBB14:
    # preds: BBB2
    goto BB0
    # -> BBB4
    # throws -> BB10

BBB15:
    # preds: BBB4
    goto BB0
    # -> BBB4
    # throws -> BB10

BBB16:
    # preds: BBB5
    goto BB0
    # -> BBB4
    # throws -> BB10

BBB17:
    # preds: BBB7
    goto BB0
    # -> BBB9
    # throws -> BB10

BBB18:
    # preds: BBB7
    goto BB0
    # -> BBB4
    # throws -> BB10

BBB19:
    # preds: BBB9
    goto BB0
    # -> BBB4
    # throws -> BB10

