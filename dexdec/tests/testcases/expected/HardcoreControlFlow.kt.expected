public open class HardcoreControlFlow {
    private fun check(i: Int): Boolean {
        if (i <= 0) {
            return false
        }
        return true
    }

    private fun modify(i: Int): Boolean {
        if (i % 2 != 0) {
            return false
        }
        return true
    }

    public open fun complexLogic(i: Int, i2: Int): Boolean {
        if (this.check(i)) {
            return true
        }
        if (this.modify(i) && this.check(i2)) {
            return true
        }
        if (this.modify(i2)) {
            return true
        }
        return false
    }

    public open fun exceptionSpaghetti(i: Int, i2: Int): Int {
        var i4: Int = 0
        var i6: Int = 0
        if (i <= 0) {
            try {
                i6 = -2
                throw IllegalArgumentException()
            } catch (exception5: IllegalArgumentException) {
                i6 = i4 - 100
                if (i6 <= 0) {
                    return i6
                }
                return i6 * 2
            } catch (exception4: ArithmeticException) {
                return i6
            } catch (exception3: Throwable) {
                if (i4 <= 0) {
                    throw exception3
                }
                return i4 * 2
            }
        }
        val i3: Int = 0
        try {
            i6 = -2
            val i5: Int = i / i2
            if (i5 <= 10) {
                i6 = i5 + 100
                if (i6 <= 0) {
                    return i6
                }
                return i6 * 2
            }
            val i7: Int = i5 + 100
            if (i7 <= 0) {
                return i5
            }
            return i7 * 2
        } catch (exception2: ArithmeticException) {
            throw exception2
        } catch (exception: Throwable) {
            i4 = i3 + 100
            try {
                throw exception
            } catch (exception5: IllegalArgumentException) {
                i6 = i4 - 100
                if (i6 <= 0) {
                    return i6
                }
                return i6 * 2
            } catch (exception4: ArithmeticException) {
                return i6
            } catch (exception3: Throwable) {
                if (i4 <= 0) {
                    throw exception3
                }
                return i4 * 2
            }
        }
    }

    public open fun labeledBreaks(iArrArr: Array<IntArray?>): Int {
        var index: Int = 0
        var total: Int = 0
        while (index < iArrArr.size) {
            if (iArrArr[index] !== null) {
                var index2: Int = 0
                var condition: Boolean = false
                while (index2 < iArrArr[index]!!.size) {
                    val i: Int = iArrArr[index]!![index2]
                    if (i == -1) {
                        return total
                    }
                    if (i == -2) {
                        break
                    }
                    if (i == -3) {
                        break
                    }
                    if (i > 100) {
                        var step: Int = 0
                        while (step < i) {
                            if (step * index2 > 1000) {
                                total += step
                                condition = true
                                break
                            }
                            step++
                        }
                        if (condition) {
                            break
                        }
                    }
                    total += i
                    index2++
                }
            }
            index++
        }
        return total
    }

    public open fun stateMachine(iArr: IntArray): Int {
        var index: Int = 0
        var total: Int = 0
        var selector: Int = 0
        while (index < iArr.size) {
            val step: Int = iArr[index]
            when (selector) {
                0 -> {
                    if (step > 0) {
                        total += step
                        selector = 1
                    } else {
                        if (step >= 0) {
                            return total
                        }
                        selector = 2
                    }
                }
                1 -> {
                    if (step != 0) {
                        total *= 2
                        index++
                    } else {
                        selector = 0
                    }
                }
                2 -> {
                    total -= step
                    selector = 0
                }
                else -> {
                    return -1
                }
            }
            index++
        }
        return total
    }
}
