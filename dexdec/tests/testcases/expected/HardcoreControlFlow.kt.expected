public open class HardcoreControlFlow {
    private fun check(p0: Int): Boolean {
        if (p0 <= 0) {
            return false
        }
        return true
    }

    private fun modify(p0: Int): Boolean {
        if (p0 % 2 != 0) {
            return false
        }
        return true
    }

    public open fun complexLogic(p0: Int, p1: Int): Boolean {
        if (this.check(p0)) {
            return true
        }
        if (this.modify(p0) && this.check(p1)) {
            return true
        }
        if (this.modify(p1)) {
            return true
        }
        return false
    }

    public open fun exceptionSpaghetti(p0: Int, p1: Int): Int {
        var value2: Int = 0
        var value4: Int = 0
        if (p0 <= 0) {
            try {
                value4 = -2
                throw IllegalArgumentException()
            } catch (exception5: IllegalArgumentException) {
                value4 = value2 - 100
                if (value4 <= 0) {
                    return value4
                }
                return value4 * 2
            } catch (exception4: ArithmeticException) {
                return value4
            } catch (exception3: Throwable) {
                if (value2 <= 0) {
                    throw exception3
                }
                return value2 * 2
            }
        }
        val value: Int = 0
        try {
            value4 = -2
            val value3: Int = p0 / p1
            if (value3 <= 10) {
                value4 = value3 + 100
                if (value4 <= 0) {
                    return value4
                }
                return value4 * 2
            }
            val value5: Int = value3 + 100
            if (value5 <= 0) {
                return value3
            }
            return value5 * 2
        } catch (exception2: ArithmeticException) {
            throw exception2
        } catch (exception: Throwable) {
            value2 = value + 100
            try {
                throw exception
            } catch (exception5: IllegalArgumentException) {
                value4 = value2 - 100
                if (value4 <= 0) {
                    return value4
                }
                return value4 * 2
            } catch (exception4: ArithmeticException) {
                return value4
            } catch (exception3: Throwable) {
                if (value2 <= 0) {
                    throw exception3
                }
                return value2 * 2
            }
        }
    }

    public open fun labeledBreaks(valueses: Array<IntArray?>): Int {
        var index: Int = 0
        var total: Int = 0
        while (index < valueses.size) {
            if (valueses[index] !== null) {
                var index2: Int = 0
                var condition: Boolean = false
                while (index2 < valueses[index]!!.size) {
                    val element: Int = valueses[index]!![index2]
                    if (element == -1) {
                        return total
                    }
                    if (element == -2) {
                        break
                    }
                    if (element == -3) {
                        break
                    }
                    if (element > 100) {
                        var step: Int = 0
                        while (step < element) {
                            if (step * index2 > 1000) {
                                total += step
                                condition = true
                                break
                            }
                            step++
                        }
                        if (condition) {
                            break
                        }
                    }
                    total += element
                    index2++
                }
            }
            index++
        }
        return total
    }

    public open fun stateMachine(values: IntArray): Int {
        var index: Int = 0
        var total: Int = 0
        var selector: Int = 0
        while (index < values.size) {
            val step: Int = values[index]
            when (selector) {
                0 -> {
                    if (step > 0) {
                        total += step
                        selector = 1
                    } else {
                        if (step >= 0) {
                            return total
                        }
                        selector = 2
                    }
                }
                1 -> {
                    if (step != 0) {
                        total *= 2
                        index++
                    } else {
                        selector = 0
                    }
                }
                2 -> {
                    total -= step
                    selector = 0
                }
                else -> {
                    return -1
                }
            }
            index++
        }
        return total
    }
}
