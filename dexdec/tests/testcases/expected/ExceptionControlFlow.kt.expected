public open class ExceptionControlFlow {
    companion object {
        public fun finallySideEffect(iArr: IntArray?): Int {
            try {
                iArr!![0] = 1
                return iArr[0]
            } finally {
                iArr!![0] = iArr!![0] + 1
            }
        }

        public fun nestedTry(i: Int): Int {
            if (i >= 0) {
                return 1
            }
            try {
                throw IllegalArgumentException()
            } catch (exception2: IllegalArgumentException) {
                return 2
            } catch (exception: RuntimeException) {
                return 3
            }
        }

        public fun nestedTryFinally(i: Int): Int {
            var result: Int = 0
            if (i >= 0) {
                result = 11
                return result
            }
            try {
                result = 2
                throw IllegalArgumentException()
            } catch (exception: Throwable) {
                try {
                    throw exception
                } catch (exception2: RuntimeException) {
                    return result
                }
            }
        }

        public fun tryCatchFinally(i: Int, i2: Int): Int {
            try {
                if (i2 == 0) {
                    throw ArithmeticException()
                }
                return i / i2
            } catch (exception2: ArithmeticException) {
                return -1
            } catch (exception: Throwable) {
                throw exception
            }
        }

        public fun tryCatchFinallyWithContinue(iArr: IntArray?): Int {
            var index: Int = 0
            var total: Int = 0
            while (index < iArr!!.size) {
                var condition: Boolean = false
                var i: Int = 0
                try {
                    if (iArr[index] != 0) {
                        i = 100 / iArr[index]
                    } else {
                        total += 2
                        index++
                        condition = true
                    }
                } catch (exception2: ArithmeticException) {
                    total = total - 1 + 2
                    index++
                    condition = true
                } catch (exception: Throwable) {
                    throw exception
                }
                if (!condition) {
                    val step: Int = total + i
                    if (step > 50) {
                        return step
                    }
                    total = step + 2
                    index++
                }
            }
            return total
        }

        public fun tryInLoop(iArr: IntArray?): Int {
            var index: Int = 0
            var total: Int = 0
            while (index < iArr!!.size) {
                try {
                    if (iArr[index] != 0) {
                        total += 10 / iArr[index]
                    }
                    index++
                } catch (exception: ArithmeticException) {
                    return total
                }
            }
            return total
        }
    }
}
