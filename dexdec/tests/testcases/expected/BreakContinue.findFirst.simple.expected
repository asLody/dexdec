.method findFirst
.registers 4
.ins 2
.entry BBB0

BBB0:  # entry
    nop
    const v0 = 0  # 0001:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB4
    v1 = v2.length  # 0002:
    if v0 >= v1 goto BB14  # 0003:
    # -> BBB5, BBB2

BBB2:
    # preds: BBB1
    v1 = v2[v0]  # 0005:
    if v1 != v3 goto BB11  # 0007:
    # -> BBB4, BBB3

BBB3:
    # preds: BBB2
    nop  # 0009:
    goto BB15  # 000a:
    # -> BBB6

BBB4:
    # preds: BBB2
    v0 = v0 + 1  # 000b:
    goto BB2  # 000d:
    # -> BBB1

BBB5:
    # preds: BBB1
    const v0 = -1  # 000e:
    # -> BBB6

BBB6:
    # preds: BBB3, BBB5
    return v0  # 000f:

