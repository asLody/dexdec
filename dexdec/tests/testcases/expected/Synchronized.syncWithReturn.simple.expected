.method syncWithReturn
.registers 3
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/Throwable; {BB5..BB19} -> BB17

BBB0:  # entry
    v0 = LSynchronized;->lock:Ljava/lang/Object;
    monitor-enter v0  # 0002:
    if v2 != 0 goto BB8  # 0003:
    # -> BBB3, BBB1

BBB1:
    # preds: BBB0
    monitor-exit v0  # 0005:
    # -> BBB2, BBB10
    # throws -> BB17

BBB2:
    # preds: BBB1
    return -1  # 0007:
    # throws -> BB17

BBB3:
    # preds: BBB0
    v1 = 100 / v2  # 000a:
    # -> BBB4, BBB11
    # throws -> BB17

BBB4:
    # preds: BBB3
    LSynchronized;->counter:I = v1  # 000b:
    # -> BBB5, BBB12
    # throws -> BB17

BBB5:
    # preds: BBB4
    v2 = LSynchronized;->counter:I  # 000d:
    # -> BBB6, BBB13
    # throws -> BB17

BBB6:
    # preds: BBB5
    monitor-exit v0  # 000f:
    # -> BBB7, BBB14
    # throws -> BB17

BBB7:
    # preds: BBB6
    return v2  # 0010:
    # throws -> BB17

BBB8:
    # preds: BBB10, BBB11, BBB12, BBB13, BBB14, BBB15
    move-exception v2  # 0011:
    monitor-exit v0  # 0012:
    # -> BBB9, BBB15
    # throws -> BB17

BBB9:
    # preds: BBB8
    throw v2  # 0013:

BBB10:
    # preds: BBB1
    goto BB0
    # -> BBB8
    # throws -> BB17

BBB11:
    # preds: BBB3
    goto BB0
    # -> BBB8
    # throws -> BB17

BBB12:
    # preds: BBB4
    goto BB0
    # -> BBB8
    # throws -> BB17

BBB13:
    # preds: BBB5
    goto BB0
    # -> BBB8
    # throws -> BB17

BBB14:
    # preds: BBB6
    goto BB0
    # -> BBB8
    # throws -> BB17

BBB15:
    # preds: BBB8
