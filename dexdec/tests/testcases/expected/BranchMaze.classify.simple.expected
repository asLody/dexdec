BBB10:
    # preds: BBB3, BBB8, BBB9
    if v1 != 2 goto BB27  # 0013:
    # -> BBB23, BBB11

BBB11:
    # preds: BBB10
    if v2 < v3 goto BB25  # 0015:
    # -> BBB24, BBB12

BBB12:
    # preds: BBB11
    if v4 >= 0 goto BB27  # 0017:
    # -> BBB25, BBB26

BBB13:
    # preds: BBB24, BBB26
    v1 = v1 + 10  # 0019:
    # -> BBB14

BBB14:
    # preds: BBB13, BBB23, BBB25
    return v1  # 001b:

