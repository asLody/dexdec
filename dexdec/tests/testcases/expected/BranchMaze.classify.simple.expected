.method classify
.registers 5
.ins 3
.entry BBB0

BBB0:  # entry
    if v2 <= 0 goto BB9  # 0001:
    # -> BBB15, BBB1

BBB1:
    # preds: BBB0
    if v3 < 0 goto BB7  # 0003:
    # -> BBB16, BBB2

BBB2:
    # preds: BBB1
    if v4 != 0 goto BB9  # 0005:
    # -> BBB17, BBB18

BBB3:
    # preds: BBB16, BBB18
    const v1 = 1  # 0007:
    goto BB19  # 0008:
    # -> BBB10

BBB4:
    # preds: BBB15, BBB17
