.method test
.registers 2
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/RuntimeException; {BB4..BB5} -> BB28
# .catch Ljava/lang/Throwable; {BB4..BB5} -> BB20
# .catch Ljava/lang/RuntimeException; {BB12..BB20} -> BB28
# .catch Ljava/lang/Throwable; {BB12..BB20} -> BB20

BBB0:  # entry
    if v1 == 0 goto BB12
    # -> BBB4, BBB1

BBB1:
    # preds: BBB0
    # -> BBB2

BBB2:
    # preds: BBB1
    v0 = 100 / v1  # 0004:
    # -> BBB3, BBB9, BBB10
    # throws -> BB28, BB20

BBB3:
    # preds: BBB2
    v1 = LFinally;->counter:I  # 0005:
    v1 = v1 + 1  # 0007:
    LFinally;->counter:I = v1  # 0009:
    return v0  # 000b:

BBB4:
    # preds: BBB0
    nop
    # -> BBB5, BBB11, BBB12
    # throws -> BB28, BB20

BBB5:
    # preds: BBB4
    const-string v0 = "zero"  # 000e:
    v1 = new Ljava/lang/RuntimeException;(v0)  # 0010:
    # -> BBB6, BBB13, BBB14
    # throws -> BB28, BB20

BBB6:
    # preds: BBB5
    throw v1  # 0013:
    # -> BBB15, BBB16
    # throws -> BB28, BB20

BBB7:
    # preds: BBB10, BBB12, BBB14, BBB16
    move-exception v1  # 0014:
    v0 = LFinally;->counter:I  # 0015:
    v0 = v0 + 1  # 0017:
    LFinally;->counter:I = v0  # 0019:
    throw v1  # 001b:

BBB8:
    # preds: BBB9, BBB11, BBB13, BBB15
    move-exception v1  # 001c:
    nop  # 001d:
    v1 = LFinally;->counter:I  # 001e:
    v1 = v1 + 1  # 0020:
    LFinally;->counter:I = v1  # 0022:
    return -1  # 0025:

BBB9:
    # preds: BBB2
    goto BB0
    # -> BBB8

BBB10:
    # preds: BBB2
    goto BB0
    # -> BBB7

BBB11:
    # preds: BBB4
    goto BB0
    # -> BBB8

BBB12:
    # preds: BBB4
    goto BB0
    # -> BBB7
    # throws -> BB28, BB20

BBB13:
    # preds: BBB5
    goto BB0
    # -> BBB8
    # throws -> BB28, BB20

BBB14:
    # preds: BBB5
    goto BB0
    # -> BBB7
    # throws -> BB28, BB20

BBB15:
    # preds: BBB6
    goto BB0
    # -> BBB8
    # throws -> BB28, BB20

BBB16:
    # preds: BBB6
    goto BB0
    # -> BBB7
    # throws -> BB28, BB20

