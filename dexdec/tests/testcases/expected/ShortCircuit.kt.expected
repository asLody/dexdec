public open class ShortCircuit {
    companion object {
        public fun checkAnd(p0: Int, p1: Int): Boolean {
            if (p0 <= 0) {
                return false
            }
            if (p1 <= 0) {
                return false
            }
            return true
        }

        public fun checkComplex(p0: Int, p1: Int, p2: Int, p3: Int): Boolean {
            if (p1 > 0 && p0 > 0) {
                return true
            }
            if (p2 <= 0) {
                return false
            }
            if (p3 <= 0) {
                return false
            }
            return true
        }

        public fun checkNegated(p0: Int, p1: Int): Boolean {
            if (p0 <= 0) {
                return true
            }
            if (p1 > 0) {
                return false
            }
            return true
        }

        public fun checkOr(p0: Int, p1: Int): Boolean {
            if (p0 > 0) {
                return true
            }
            if (p1 <= 0) {
                return false
            }
            return true
        }
    }
}
