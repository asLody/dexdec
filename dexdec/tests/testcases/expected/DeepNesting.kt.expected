public open class DeepNesting {
    companion object {
        public fun classify(i: Int, i2: Int, i3: Int): Int {
            if (i <= 0) {
                if (i2 <= 0) {
                    return 6
                }
                return 5
            }
            if (i2 <= 0) {
                if (i3 <= 0) {
                    return 4
                }
                return 3
            }
            if (i3 <= 0) {
                return 2
            }
            return 1
        }

        public fun conditionalSum(i: Int): Int {
            var step: Int = 0
            var total: Int = 0
            while (step < i) {
                if (step % 2 != 0) {
                    total -= step
                } else {
                    total += step
                }
                step++
            }
            return total
        }

        public fun matrixSum(i: Int, i2: Int): Int {
            var i3: Int = 0
            var result: Int = 0
            while (i3 < i) {
                var i4: Int = 0
                while (i4 < i2) {
                    result = result + i3 * i2 + i4
                    i4++
                }
                i3++
            }
            return result
        }
    }
}
