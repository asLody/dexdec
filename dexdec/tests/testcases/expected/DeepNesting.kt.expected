public open class DeepNesting {
    companion object {
        public fun classify(p0: Int, p1: Int, p2: Int): Int {
            if (p0 <= 0) {
                if (p1 <= 0) {
                    return 6
                }
                return 5
            }
            if (p1 <= 0) {
                if (p2 <= 0) {
                    return 4
                }
                return 3
            }
            if (p2 <= 0) {
                return 2
            }
            return 1
        }

        public fun conditionalSum(p0: Int): Int {
            var step: Int = 0
            var total: Int = 0
            while (step < p0) {
                if (step % 2 != 0) {
                    total -= step
                } else {
                    total += step
                }
                step++
            }
            return total
        }

        public fun matrixSum(p0: Int, p1: Int): Int {
            var value: Int = 0
            var result: Int = 0
            while (value < p0) {
                var value2: Int = 0
                while (value2 < p1) {
                    result = result + value * p1 + value2
                    value2++
                }
                value++
            }
            return result
        }
    }
}
