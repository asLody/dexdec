.method syncWithTry
.registers 3
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/ArithmeticException; {BB5..BB8} -> BB11
# .catch Ljava/lang/Throwable; {BB5..BB8} -> BB9
# .catch Ljava/lang/Throwable; {BB13..BB16} -> BB9
# .catch Ljava/lang/Throwable; {BB19..BB20} -> BB9

BBB0:  # entry
    v0 = LSynchronized;->lock:Ljava/lang/Object;
    monitor-enter v0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0
    v1 = 100 / v2  # 0005:
    # -> BBB2, BBB11, BBB12
    # throws -> BB11, BB9

BBB2:
    # preds: BBB1
    LSynchronized;->counter:I = v1  # 0006:
    # -> BBB13, BBB14, BBB15
    # throws -> BB11, BB9

BBB4:
    # preds: BBB12, BBB15, BBB17, BBB18, BBB19
    move-exception v2  # 0009:
    goto BB19  # 000a:
    # -> BBB9

BBB5:
    # preds: BBB11, BBB14
    move-exception v2  # 000b:
    # -> BBB6

BBB6:
    # preds: BBB5
    LSynchronized;->counter:I = -1  # 000d:
    # -> BBB16, BBB17
    # throws -> BB9

BBB7:
    # preds: BBB13, BBB16
    monitor-exit v0  # 000f:
    # -> BBB8, BBB18
    # throws -> BB9

BBB8:
    # preds: BBB7
    v2 = LSynchronized;->counter:I  # 0010:
    return v2  # 0012:

BBB9:
    # preds: BBB4
    monitor-exit v0  # 0013:
    # -> BBB10, BBB19
    # throws -> BB9

BBB10:
    # preds: BBB9
    throw v2  # 0014:

BBB11:
    # preds: BBB1
    goto BB0
    # -> BBB5

BBB12:
    # preds: BBB1
    goto BB0
    # -> BBB4

BBB13:
    # preds: BBB2
    goto BB0
    # -> BBB7
    # throws -> BB9

BBB14:
    # preds: BBB2
    goto BB0
    # -> BBB5
    # throws -> BB9

BBB15:
    # preds: BBB2
    goto BB0
    # -> BBB4
    # throws -> BB9

BBB16:
    # preds: BBB6
    goto BB0
    # -> BBB7

BBB17:
    # preds: BBB6
    goto BB0
    # -> BBB4

BBB18:
    # preds: BBB7
    goto BB0
    # -> BBB4

BBB19:
    # preds: BBB9
    goto BB0
    # -> BBB4
    # throws -> BB9

