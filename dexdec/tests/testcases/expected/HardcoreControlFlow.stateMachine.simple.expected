.method stateMachine
.registers 8
.ins 2
.entry BBB0

BBB0:  # entry
    nop
    nop  # 0001:
    const v0 = 0  # 0002:
    const v1 = 0  # 0003:
    const v2 = 0  # 0004:
    const v3 = 0  # 0005:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB12
    v4 = v7.length  # 0006:
    if v1 >= v4 goto BB42  # 0007:
    # -> BBB14, BBB2

BBB2:
    # preds: BBB1
    v4 = v7[v1]  # 0009:
    if v3 < 1 goto BB0  # 0009:
    # -> BBB15, BBB16

BBB3:
    # preds: BBB19, BBB20, BBB21
    return -1  # 0010:

BBB4:
    # preds: BBB18
    v2 = v2 - v4  # 0011:
    nop  # 0012:
    const v3 = 0  # 0013:
    goto BB39  # 0014:
    # -> BBB12

BBB5:
    # preds: BBB17
    if v4 != 0 goto BB25  # 0015:
    # -> BBB7, BBB6

BBB6:
    # preds: BBB5
    const v3 = 0  # 0017:
    goto BB39  # 0018:
    # -> BBB12

BBB7:
    # preds: BBB5
    v2 = v2 * 2  # 0019:
    v1 = v1 + 1  # 001b:
    goto BB39  # 001d:
    # -> BBB12

BBB8:
    # preds: BBB15
    if v4 <= 0 goto BB36  # 001e:
    # -> BBB10, BBB9

BBB9:
    # preds: BBB8
    nop  # 0020:
    v2 = v2 + v4  # 0021:
    const v3 = 1  # 0022:
    goto BB39  # 0023:
    # -> BBB12

BBB10:
    # preds: BBB8
    if v4 >= 0 goto BB41  # 0024:
    # -> BBB13, BBB11

BBB11:
    # preds: BBB10
    const v3 = 2  # 0026:
    # -> BBB12

BBB12:
    # preds: BBB4, BBB6, BBB7, BBB9, BBB11
    v1 = v1 + 1  # 0027:
    goto BB6  # 0028:
    # -> BBB1

BBB13:
    # preds: BBB10
    return v2  # 0029:

BBB14:
    # preds: BBB1
    return v2  # 002a:

BBB15:
    # preds: BBB2
    if v3 == 0 goto BB0  # 0009:
    # -> BBB8, BBB19

BBB16:
    # preds: BBB2
    if v3 < 2 goto BB0  # 0009:
    # -> BBB17, BBB18

BBB17:
    # preds: BBB16
    if v3 == 1 goto BB0  # 0009:
    # -> BBB5, BBB20

BBB18:
    # preds: BBB16
    if v3 == 2 goto BB0  # 0009:
    # -> BBB4, BBB21

BBB19:
    # preds: BBB15
    goto BB0
    # -> BBB3

BBB20:
    # preds: BBB17
    goto BB0
    # -> BBB3

BBB21:
    # preds: BBB18
    goto BB0
    # -> BBB3

