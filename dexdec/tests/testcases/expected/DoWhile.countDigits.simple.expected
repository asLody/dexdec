.method countDigits
.registers 2
.ins 1
.entry BBB0

BBB0:  # entry
    const v0 = 0
    # -> BBB1

BBB1:
    # preds: BBB0, BBB3
    v0 = v0 + 1  # 0001:
    v1 = v1 / 10  # 0003:
    if v1 > 0 goto BB1  # 0005:
    # -> BBB3, BBB2

BBB2:
    # preds: BBB1
    return v0  # 0007:

BBB3:
    # preds: BBB1
    goto BB0
    # -> BBB1

