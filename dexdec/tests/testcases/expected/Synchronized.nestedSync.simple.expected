.method nestedSync
.registers 3
.ins 2
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/Throwable; {BB3..BB4} -> BB16
# .catch Ljava/lang/Throwable; {BB6..BB9} -> BB13
# .catch Ljava/lang/Throwable; {BB9..BB10} -> BB16
# .catch Ljava/lang/Throwable; {BB14..BB15} -> BB13
# .catch Ljava/lang/Throwable; {BB15..BB18} -> BB16

BBB0:  # entry
    v0 = LSynchronized;->lock:Ljava/lang/Object;
    monitor-enter v0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0
    monitor-enter v1  # 0003:
    # -> BBB2, BBB12
    # throws -> BB16

BBB2:
    # preds: BBB1
    v2 = v2 * 2  # 0004:
    # -> BBB3

BBB3:
    # preds: BBB2
    LSynchronized;->counter:I = v2  # 0006:
    # -> BBB4, BBB13
    # throws -> BB13

BBB4:
    # preds: BBB3
    monitor-exit v1  # 0008:
    # -> BBB5, BBB14
    # throws -> BB13

BBB5:
    # preds: BBB4
    monitor-exit v0  # 0009:
    # -> BBB6, BBB15
    # throws -> BB16

BBB6:
    # preds: BBB5
    v1 = LSynchronized;->counter:I  # 000a:
    return v1  # 000c:

BBB7:
    # preds: BBB13, BBB14, BBB16
    move-exception v2  # 000d:
    # -> BBB8

BBB8:
    # preds: BBB7
    monitor-exit v1  # 000e:
    # -> BBB9, BBB16
    # throws -> BB13

BBB9:
    # preds: BBB8
    throw v2  # 000f:
    # -> BBB10
    # throws -> BB16

BBB10:
    # preds: BBB9, BBB12, BBB15, BBB17
    move-exception v1  # 0010:
    monitor-exit v0  # 0011:
    # -> BBB11, BBB17
    # throws -> BB16

BBB11:
    # preds: BBB10
    throw v1  # 0012:

BBB12:
    # preds: BBB1
    goto BB0
    # -> BBB10

BBB13:
    # preds: BBB3
    goto BB0
    # -> BBB7

BBB14:
    # preds: BBB4
    goto BB0
    # -> BBB7
    # throws -> BB13

BBB15:
    # preds: BBB5
    goto BB0
    # -> BBB10
    # throws -> BB16

BBB16:
    # preds: BBB8
    goto BB0
    # -> BBB7
    # throws -> BB16

BBB17:
    # preds: BBB10
    goto BB0
    # -> BBB10
    # throws -> BB16

