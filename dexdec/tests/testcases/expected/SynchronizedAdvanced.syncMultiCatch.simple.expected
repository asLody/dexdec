.method syncMultiCatch
.registers 3
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/ArithmeticException; {BB7..BB8} -> BB14
# .catch Ljava/lang/IllegalArgumentException; {BB7..BB8} -> BB12
# .catch Ljava/lang/Throwable; {BB7..BB8} -> BB10
# .catch Ljava/lang/Throwable; {BB8..BB9} -> BB10
# .catch Ljava/lang/ArithmeticException; {BB16..BB22} -> BB14
