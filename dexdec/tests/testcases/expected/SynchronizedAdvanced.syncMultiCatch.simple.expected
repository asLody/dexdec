# .catch Ljava/lang/Throwable; {BB16..BB22} -> BB10
# .catch Ljava/lang/Throwable; {BB22..BB29} -> BB10

BBB0:  # entry
    v0 = LSynchronizedAdvanced;->lock1:Ljava/lang/Object;
    monitor-enter v0  # 0002:
    if v2 < 0 goto BB16  # 0003:
    # -> BBB8, BBB1

BBB1:
    # preds: BBB0
    # -> BBB2

BBB2:
