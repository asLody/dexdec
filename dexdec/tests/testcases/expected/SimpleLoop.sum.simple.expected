.method sum
.registers 3
.ins 1
.entry BBB0

BBB0:  # entry
    nop
    const v0 = 0  # 0001:
    const v1 = 0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB2
    if v0 >= v2 goto BB9  # 0003:
    # -> BBB3, BBB2

BBB2:
    # preds: BBB1
    v1 = v1 + v0  # 0005:
    v0 = v0 + 1  # 0006:
    goto BB3  # 0008:
    # -> BBB1

BBB3:
    # preds: BBB1
    return v1  # 0009:

