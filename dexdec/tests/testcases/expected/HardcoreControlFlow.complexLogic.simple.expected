.method complexLogic
.registers 4
.ins 3
.entry BBB0

BBB0:  # entry
    invoke-direct LHardcoreControlFlow;->check(I)Z(v1, v2)
    move-result v0  # 0003:
    if v0 != 0 goto BB27  # 0004:
    # -> BBB7, BBB1

BBB1:
    # preds: BBB0
    invoke-direct LHardcoreControlFlow;->modify(I)Z(v1, v2)  # 0006:
    move-result v2  # 0009:
    if v2 == 0 goto BB18  # 000a:
    # -> BBB8, BBB2

BBB2:
    # preds: BBB1
    invoke-direct LHardcoreControlFlow;->check(I)Z(v1, v3)  # 000c:
    move-result v2  # 000f:
    if v2 != 0 goto BB27  # 0010:
    # -> BBB9, BBB10

BBB3:
    # preds: BBB8, BBB10
    invoke-direct LHardcoreControlFlow;->modify(I)Z(v1, v3)  # 0012:
    move-result v2  # 0015:
    if v2 == 0 goto BB25  # 0016:
    # -> BBB5, BBB11

BBB5:
    # preds: BBB3
    return 0  # 001a:

BBB6:
    # preds: BBB7, BBB9, BBB11
    return 1  # 001c:

BBB7:
    # preds: BBB0
    goto BB0
    # -> BBB6

BBB8:
    # preds: BBB1
    goto BB0
    # -> BBB3

BBB9:
    # preds: BBB2
    goto BB0
    # -> BBB6

BBB10:
    # preds: BBB2
    goto BB0
    # -> BBB3

BBB11:
    # preds: BBB3
    goto BB0
    # -> BBB6

