.method sumUntil
.registers 5
.ins 2
.entry BBB0

BBB0:  # entry
    nop
    const v0 = 0  # 0001:
    const v1 = 0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB6
    v2 = v3.length  # 0003:
    if v0 >= v2 goto BB18  # 0004:
    # -> BBB8, BBB2

BBB2:
    # preds: BBB1
    v2 = v3[v0]  # 0006:
    if v2 >= 0 goto BB11  # 0008:
    # -> BBB4, BBB9

BBB4:
    # preds: BBB2
    v1 = v1 + v2  # 000b:
    if v1 <= v4 goto BB15  # 000c:
    # -> BBB10, BBB11

BBB6:
    # preds: BBB9, BBB10
    v0 = v0 + 1  # 000f:
    goto BB3  # 0011:
    # -> BBB1

BBB7:
    # preds: BBB8, BBB11
    return v1  # 0012:

BBB8:
    # preds: BBB1
    goto BB0
    # -> BBB7

BBB9:
    # preds: BBB2
    goto BB0
    # -> BBB6

BBB10:
    # preds: BBB4
    goto BB0
    # -> BBB6

BBB11:
    # preds: BBB4
    goto BB0
    # -> BBB7

