.method nestedTryFinally
.registers 1
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/Throwable; {BB9..BB15} -> BB15
# .catch Ljava/lang/RuntimeException; {BB16..BB17} -> BB17

BBB0:  # entry
    nop
    if v0 < 0 goto BB9  # 0001:
    # -> BBB2, BBB1

BBB1:
    # preds: BBB0
    nop  # 0003:
    nop  # 0004:
    nop  # 0005:
    const v0 = 11  # 0006:
    goto BB19  # 0008:
    # -> BBB8

BBB2:
    # preds: BBB0
    nop
    # -> BBB3, BBB9
    # throws -> BB15

BBB3:
    # preds: BBB2
    v0 = new Ljava/lang/IllegalArgumentException;()  # 000b:
    # -> BBB4, BBB10
    # throws -> BB15

BBB4:
    # preds: BBB3
    throw v0  # 000e:
    # -> BBB5
    # throws -> BB15

BBB5:
    # preds: BBB4, BBB9, BBB10
    move-exception v0  # 000f:
    # -> BBB6

BBB6:
    # preds: BBB5
    throw v0  # 0010:
    # -> BBB7
    # throws -> BB17

BBB7:
    # preds: BBB6
    move-exception v0  # 0011:
    const v0 = 2  # 0012:
    # -> BBB8

BBB8:
    # preds: BBB1, BBB7
    return v0  # 0013:

BBB9:
    # preds: BBB2
    goto BB0
    # -> BBB5
    # throws -> BB15

BBB10:
    # preds: BBB3
    goto BB0
    # -> BBB5
    # throws -> BB15

