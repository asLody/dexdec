.method earlyReturn
.registers 1
.ins 1
.entry BBB0

BBB0:  # entry
    if v0 >= 0 goto BB4
    # -> BBB2, BBB1

BBB1:
    # preds: BBB0
    return -1  # 0003:

BBB2:
    # preds: BBB0
    if v0 != 0 goto BB8  # 0004:
    # -> BBB4, BBB3

BBB3:
    # preds: BBB2
    return 0  # 0007:

BBB4:
    # preds: BBB2
    return 1  # 0009:

