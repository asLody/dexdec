public open class BranchMaze {
    companion object {
        public fun classify(i: Int, i2: Int, i3: Int): Int {
            var result: Int
            if (i > 0 && (i2 < 0 || i3 == 0)) {
                result = 1
            } else {
                result = 2
                if (i != 0 && (i2 <= 0 || i3 <= 0)) {
                    result = 3
                }
            }
            if (result != 2) {
                return result
            }
            if (i3 >= 0 && i >= i2) {
                return result
            }
            return result + 10
        }
    }
}
