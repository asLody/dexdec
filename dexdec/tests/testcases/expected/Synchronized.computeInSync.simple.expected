.method computeInSync
.registers 3
.ins 2
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/Throwable; {BB4..BB10} -> BB8

BBB0:  # entry
    v0 = LSynchronized;->lock:Ljava/lang/Object;
    monitor-enter v0  # 0002:
    v1 = v1 + v2  # 0003:
    # -> BBB1

BBB1:
    # preds: BBB0
    LSynchronized;->counter:I = v1  # 0004:
    # -> BBB2, BBB6
    # throws -> BB8

BBB2:
    # preds: BBB1
    monitor-exit v0  # 0006:
    # -> BBB3, BBB7
    # throws -> BB8

BBB3:
    # preds: BBB2
    return v1  # 0007:
    # throws -> BB8

BBB4:
    # preds: BBB6, BBB7, BBB8
    move-exception v1  # 0008:
    monitor-exit v0  # 0009:
    # -> BBB5, BBB8
    # throws -> BB8

BBB5:
    # preds: BBB4
    throw v1  # 000a:

BBB6:
    # preds: BBB1
    goto BB0
    # -> BBB4
    # throws -> BB8

BBB7:
    # preds: BBB2
    goto BB0
    # -> BBB4
    # throws -> BB8

BBB8:
    # preds: BBB4
    goto BB0
    # -> BBB4
    # throws -> BB8

