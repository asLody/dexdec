.method whileSwitch
.registers 4
.ins 1
.entry BBB0

BBB0:  # entry
    nop
    const v0 = 0  # 0001:
    const v1 = 0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB8, BBB11
