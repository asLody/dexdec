    # -> BBB17, BBB2

BBB2:
    # preds: BBB1
    v2 = v3 + v0  # 0006:
    if v2 < 1 goto BB0  # 0006:
    # -> BBB13, BBB14

BBB3:
    # preds: BBB19, BBB20, BBB21
    v1 = v1 + 4  # 000b:
    goto BB23  # 000d:
    # -> BBB7

BBB4:
    # preds: BBB16
    v1 = v1 + 3  # 000e:
    goto BB23  # 0010:
    # -> BBB7

BBB5:
    # preds: BBB15
