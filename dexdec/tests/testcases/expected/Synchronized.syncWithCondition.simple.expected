.method syncWithCondition
.registers 2
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/Throwable; {BB5..BB12} -> BB15
# .catch Ljava/lang/Throwable; {BB16..BB17} -> BB15

BBB0:  # entry
    v0 = LSynchronized;->lock:Ljava/lang/Object;
    monitor-enter v0  # 0002:
    if v1 <= 0 goto BB8  # 0003:
    # -> BBB3, BBB1

BBB1:
    # preds: BBB0
    LSynchronized;->counter:I = v1  # 0005:
    # -> BBB9, BBB10
    # throws -> BB15

BBB3:
    # preds: BBB0
    v1 = -v1  # 0008:
    LSynchronized;->counter:I = v1  # 0009:
    # -> BBB11, BBB12
    # throws -> BB15

BBB4:
    # preds: BBB9, BBB11
    monitor-exit v0  # 000b:
    # -> BBB5, BBB13
    # throws -> BB15

BBB5:
    # preds: BBB4
    v1 = LSynchronized;->counter:I  # 000c:
    return v1  # 000e:

BBB6:
    # preds: BBB10, BBB12, BBB13, BBB14
    move-exception v1  # 000f:
    # -> BBB7

BBB7:
    # preds: BBB6
    monitor-exit v0  # 0010:
    # -> BBB8, BBB14
    # throws -> BB15

BBB8:
    # preds: BBB7
    throw v1  # 0011:

BBB9:
    # preds: BBB1
    goto BB0
    # -> BBB4
    # throws -> BB15

BBB10:
    # preds: BBB1
    goto BB0
    # -> BBB6
    # throws -> BB15

BBB11:
    # preds: BBB3
    goto BB0
    # -> BBB4
    # throws -> BB15

BBB12:
    # preds: BBB3
    goto BB0
    # -> BBB6

BBB13:
    # preds: BBB4
    goto BB0
    # -> BBB6

BBB14:
    # preds: BBB7
    goto BB0
    # -> BBB6

