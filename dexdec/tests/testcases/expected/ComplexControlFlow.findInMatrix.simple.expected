.method findInMatrix
.registers 8
.ins 2
.entry BBB0

BBB0:  # entry
    const v0 = 0
    const v1 = 0  # 0001:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB9
    v2 = v6.length  # 0002:
    if v1 >= v2 goto BB31  # 0004:
    # -> BBB10, BBB2

BBB2:
    # preds: BBB1
    v2 = v6[v1]  # 0006:
    const v4 = 0  # 0008:
    # -> BBB3

BBB3:
    # preds: BBB2, BBB8
    v5 = v2.length  # 0009:
    if v4 >= v5 goto BB28  # 000a:
    # -> BBB11, BBB4

BBB4:
    # preds: BBB3
    v5 = v2[v4]  # 000c:
    if v5 != v7 goto BB20  # 000e:
    # -> BBB6, BBB5

BBB5:
    # preds: BBB4
    v1 = v1 * 1000  # 0010:
    v1 = v1 + v4  # 0012:
    return v1  # 0013:

BBB6:
    # preds: BBB4
    v5 = v2[v4]  # 0014:
    if v5 != -1 goto BB25  # 0016:
    # -> BBB8, BBB12

BBB8:
    # preds: BBB6
    v4 = v4 + 1  # 0019:
    goto BB9  # 001b:
    # -> BBB3

BBB9:
    # preds: BBB11, BBB12
    v1 = v1 + 1  # 001c:
    goto BB2  # 001e:
    # -> BBB1

BBB10:
    # preds: BBB1
    return -1  # 001f:

BBB11:
    # preds: BBB3
    goto BB0
    # -> BBB9

BBB12:
    # preds: BBB6
    goto BB0
    # -> BBB9

