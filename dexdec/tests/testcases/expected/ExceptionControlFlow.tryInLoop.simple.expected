.method tryInLoop
.registers 5
.ins 1
.entry BBB0

# Exception handlers:
# .catch Ljava/lang/ArithmeticException; {BB6..BB16} -> BB21

BBB0:  # entry
    nop
    const v0 = 0  # 0001:
    const v1 = 0  # 0002:
    # -> BBB1

BBB1:
    # preds: BBB0, BBB8
    v2 = v4.length  # 0003:
    if v0 >= v2 goto BB23  # 0004:
    # -> BBB11, BBB2

BBB2:
    # preds: BBB1
    v2 = v4[v0]  # 0006:
    # -> BBB3, BBB12
    # throws -> BB21

BBB3:
    # preds: BBB2
    if v2 != 0 goto BB11  # 0008:
    # -> BBB5, BBB13
    # throws -> BB21

BBB5:
    # preds: BBB3
    v2 = v4[v0]  # 000b:
    # -> BBB6, BBB14
    # throws -> BB21

BBB6:
    # preds: BBB5
    v3 = 10 / v2  # 000f:
    # -> BBB7, BBB15
    # throws -> BB21

BBB7:
    # preds: BBB6
    v1 = v1 + v3  # 0010:
    nop  # 0011:
    # -> BBB8

BBB8:
    # preds: BBB7, BBB13
    v0 = v0 + 1  # 0012:
    goto BB3  # 0014:
    # -> BBB1

BBB9:
    # preds: BBB12, BBB14, BBB15
    move-exception v4  # 0015:
    nop  # 0016:
    # -> BBB10

BBB10:
    # preds: BBB9, BBB11
    return v1  # 0017:

BBB11:
    # preds: BBB1
    goto BB0
    # -> BBB10
    # throws -> BB21

BBB12:
    # preds: BBB2
    goto BB0
    # -> BBB9
    # throws -> BB21

BBB13:
    # preds: BBB3
    goto BB0
    # -> BBB8
    # throws -> BB21

BBB14:
    # preds: BBB5
    goto BB0
    # -> BBB9
    # throws -> BB21

BBB15:
    # preds: BBB6
    goto BB0
    # -> BBB9
    # throws -> BB21

